{
  "name": "haversine-geolocation",
  "version": "2.0.1",
  "description": "Spherical distance and nearest-point search for JavaScript/TypeScript, with validated coordinates, ESM/CJS, and no runtime dependencies",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "npm run build:runtime && npm run build:umd && npm run build:types",
    "build-pack": "npm run build && rm -f -- performy-* && npm pack",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.types.json",
    "build:umd": "vite build --config vite.umd.config.ts",
    "build:runtime": "vite build --config vite.lib.config.ts",
    "size:check": "node scripts/check-package-size.mjs",
    "quality": "biome check src spec scripts vite.lib.config.ts vite.umd.config.ts vitest.config.ts",
    "quality:fix": "biome check --write src spec scripts vite.lib.config.ts vite.umd.config.ts vitest.config.ts"
  },
  "keywords": [
    "haversine",
    "distance",
    "great-circle-distance",
    "nearest-point",
    "coordinates",
    "geolocation",
    "typescript",
    "javascript",
    "nodejs"
  ],
  "author": "Daniil Sydorenko <daniildeveloper@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaniilSydorenko/haversine-geolocation.git"
  },
  "homepage": "https://github.com/DaniilSydorenko/haversine-geolocation#readme",
  "bugs": {
    "url": "https://github.com/DaniilSydorenko/haversine-geolocation/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "@biomejs/biome": "2.6.2"
  },
  "files": [
    "dist"
  ],
  "types": "dist/types/index.d.ts",
  "module": "dist/index.mjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/types/browser.d.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.cjs"
    },
    "./legacy": {
      "types": "./dist/types/legacy.d.ts",
      "import": "./dist/legacy.mjs",
      "require": "./dist/legacy.cjs"
    },
    "./package.json": "./package.json"
  },
  "type": "module"
}

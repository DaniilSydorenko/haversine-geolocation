{
  "name": "haversine-geolocation",
  "version": "2.0.0-alpha.1",
  "description": "Get distances between two points or get closest position to current point. Based on the Haversine Formula",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "npm run build:runtime && npm run build:umd && npm run build:types",
    "build-pack": "npm run build && rm -f -- performy-* && npm pack",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.types.json",
    "build:umd": "vite build --config vite.umd.config.ts",
    "build:runtime": "vite build --config vite.lib.config.ts"
  },
  "keywords": [
    "geolocation",
    "haversine",
    "coordinates",
    "javascript",
    "es-6",
    "node.js"
  ],
  "author": "Daniil Sydorenko <daniildeveloper@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaniilSydorenko/haversine-geolocation.git"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "files": [
    "dist"
  ],
  "types": "dist/types/index.d.ts",
  "module": "dist/index.mjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/types/browser.d.ts",
      "import": "./dist/browser.mjs",
      "require": "./dist/browser.cjs"
    },
    "./legacy": {
      "types": "./dist/types/legacy.d.ts",
      "import": "./dist/legacy.mjs",
      "require": "./dist/legacy.cjs"
    },
    "./package.json": "./package.json"
  },
  "type": "module"
}
